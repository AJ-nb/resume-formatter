{
  "name": "resume-formatter",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "description": "Local-first resume editor and single-file formatter",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify:pdf": "node scripts/verify-pdf.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check": "npm test && npm run build && npm run check:release"
  },
  "dependencies": {
    "lucide": "0.468.0",
    "mammoth": "1.12.1",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.28.2",
    "jszip": "3.10.1"
  },
  "engines": {
    "node": ">=20"
  }
}
